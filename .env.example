# Copy this file to .env for local dev (docker-compose reads it automatically).
# ALL values below are placeholders safe for local dev — never put real
# secrets in this file (it's committed to a public repo). Real credentials
# for staging/production are set as actual environment variables / secrets
# on the deploy target, never committed. See README "Environments &
# credentials" for how EventConfig (per-event SMTP/Mollie) fits in.

# --- App ---
APP_ENV=development
SECRET_KEY=dev-insecure-secret-key-change-me
# Key used to encrypt EventConfig secrets (SMTP/Mollie credentials) at
# rest. Generate a real one for staging/prod, e.g.: openssl rand -hex 32
ENCRYPTION_KEY=dev-insecure-encryption-key-change-me-32b
DEFAULT_LOCALE=en

# --- Auth ---
# Admin session cookie timeout, in minutes.
SESSION_TIMEOUT_MINUTES=30
# In-memory rate limits (per client IP, per rolling minute) on the auth
# endpoints — see app/core/rate_limit.py.
LOGIN_RATE_LIMIT_PER_MINUTE=10
AGENT_AUTH_RATE_LIMIT_PER_MINUTE=30

# --- Database (matches docker-compose's `db` service) ---
DATABASE_URL=postgresql+asyncpg://beacon:beacon@db:5432/beacon

# --- Seed data defaults (used by scripts/seed.py) ---
# Demo AdminUser created for local login. Never used for real deployments.
SEED_ADMIN_EMAIL=admin@beacon.local
SEED_ADMIN_PASSWORD=dev-only-change-me-123
# Demo Event's EventConfig — NOT read by the app at request time; every
# real Event's SMTP/Mollie config is stored on its own EventConfig row,
# entered via the backoffice.
SEED_SMTP_HOST=mailpit
SEED_SMTP_PORT=1025
SEED_SMTP_USERNAME=
SEED_SMTP_PASSWORD=
SEED_SMTP_USE_TLS=false
SEED_SMTP_SENDER_NAME=Beacon Demo Event
SEED_SMTP_SENDER_EMAIL=demo@beacon.local
# Placeholder only — Mollie test-mode keys start with "test_". Get a real
# one free at https://my.mollie.com if you want to exercise real Mollie
# test-mode checkout locally; the app must never require this to boot.
SEED_MOLLIE_TEST_API_KEY=test_placeholder_replace_with_real_mollie_test_key
